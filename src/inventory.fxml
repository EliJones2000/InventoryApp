<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="InventoryController">

   <top>
      <VBox spacing="10" alignment="CENTER">

         <!-- Title -->
         <Label text="Inventory Management System">
            <font>
               <Font size="24"/>
            </font>
         </Label>

         <!-- Search Field -->
         <TextField fx:id="searchField"
                    promptText="Search by ID or Name..."
                    maxWidth="300"/>

      </VBox>
   </top>
   <!-- TABLE CENTER -->
   <center>
      <TableView fx:id="tableView">
         <columns>
            <TableColumn fx:id="idColumn" text="ID"/>
            <TableColumn fx:id="nameColumn" text="Name"/>
            <TableColumn fx:id="costColumn" text="Cost"/>
            <TableColumn fx:id="sellColumn" text="Sell"/>
            <TableColumn fx:id="quantityColumn" text="Quantity"/>
         </columns>
      </TableView>
   </center>

   <!-- BOTTOM SECTION -->
   <bottom>
      <VBox spacing="10" alignment="CENTER">

         <HBox spacing="10" alignment="CENTER">
            <Button text="Add Product" onAction="#handleAddProduct"/>
            <Button text="Sell Product" onAction="#handleSellProduct"/>
            <Button text="Remove Product" onAction="#handleRemoveProduct"/>
            <Button text="Show Low Stock" onAction="#handleLowStock"/>
            <Button text="Show All" onAction="#handleShowAll"/>
            <Button text="Clear" onAction="#handleClearSearch"/>
            <Button text="Exit" onAction="#handleExit"/>
         </HBox>

         <HBox spacing="20" alignment="CENTER">
            <Label fx:id="revenueLabel" text="Revenue: $0"/>
            <Label fx:id="profitLabel" text="Profit: $0"/>
            <Label fx:id="inventoryValueLabel" text="Inventory Value: $0"/>
            <Label fx:id="totalProductsLabel" text="Total Products: 0"/>

            <Label fx:id="lowStockLabel"
                   text=""
                   style="-fx-text-fill: red; -fx-font-weight: bold;"
                   visible="false"/>
         </HBox>

      </VBox>
   </bottom>

</BorderPane>

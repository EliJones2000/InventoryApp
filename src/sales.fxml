<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="SalesController">

    <top>
        <VBox spacing="10" alignment="CENTER">

            <Label text="Sales Management">
                <font>
                    <Font size="24"/>
                </font>
            </Label>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Back To Inventory"
                        onAction="#handleBackToInventory"/>
            </HBox>

        </VBox>
    </top>

    <center>
        <TableView fx:id="salesTable">
            <columns>
                <TableColumn fx:id="saleIdColumn" text="Sale ID"/>
                <TableColumn fx:id="productColumn" text="Product"/>
                <TableColumn fx:id="quantityColumn" text="Quantity"/>
                <TableColumn fx:id="totalColumn" text="Total"/>
                <TableColumn fx:id="timestampColumn" text="Time"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10" alignment="CENTER">

            <Label text="All sales are processed from the Inventory screen."
                   textFill="gray"/>

            <Label text="This page displays completed sales history."
                   textFill="green"/>

        </VBox>
    </bottom>

</BorderPane>